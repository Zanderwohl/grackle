name_key = "animation.states.airborne"
length = 1.0
clock = "shared"
looping = false
note = "Sampled from `airborne_pose`. Still, for now: a real jump wants keys through the arc, which is what having a timeline is for."

[[tracks]]
combine = "replace"
space = "body"
unit = "metres"
enabled = true

[tracks.channel]
channel = "rotation"
bone = "upper_arm.l"

[[tracks.channel.keys]]
at = 0.0
to = [
    0.4068158,
    -0.29920518,
    -0.6621587,
]
ease = "smoother_step"

