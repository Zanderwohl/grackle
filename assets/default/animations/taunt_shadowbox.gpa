length = 2.2
clock = "seconds"
looping = false
note = "Sampled from `humanoid_seed::shadowbox` on the reference build: a hop into a boxer's stance, left foot leading and the body side-on, the hands coming up to guard; a left, a right and two quick lefts, the hips, chest and shoulder driving in behind each and the rear heel pivoting on the right; and a hop back out. The feet are solved onto the floor and the fists onto a point ahead of the chin, so retune it there."

[[tracks]]
combine = "replace"
space = "body"
unit = "meters"
enabled = true

[tracks.channel]
