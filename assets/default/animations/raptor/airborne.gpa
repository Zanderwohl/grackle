name_key = "animation.states.airborne"
length = 1.6
clock = "shared"
looping = true
note = "Sampled from `raptor_seed::airborne`: each ankle pedals a loop half a turn behind the other, solved on the reference rig, the toes hanging and the tail lifted and swinging against the legs. Crouched, the pedal is tucked and `tuck_into_the_box` lifts what still hangs below the short box."

