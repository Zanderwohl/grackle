name_key = "animation.states.crouch"
length = 4.0
clock = "shared"
looping = true
note = "Sampled from `raptor_seed::idle` and `crouched`: a stalk, the front raised and the neck reaching forward and down with the head kept level. `duck_under` drops the hips until the crown is at the rig's `crouched_crown`. Breathing as standing does."

