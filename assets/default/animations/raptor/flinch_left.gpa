name_key = "anim.clips.flinch_left"
length = 0.5
clock = "seconds"
looping = false
note = "Written by `raptor_seed::flinch`: composed onto whatever the body is doing, on the flinch layer, which claims nothing. The front is thrown away from the hit by 0.07 s and eased back by 0.5 s, the tail swinging against it, each bone a little behind the one before. Spine, neck, head and tail only, so the feet stay planted."

[[tracks]]
combine = "compose"
space = "body"
unit = "meters"
enabled = true

[tracks.channel]
channel = "rotation"
bone = "spine"

[[tracks.channel.keys]]
at = 0.0
to = [
    -0.0,
    0.0,
    0.0,
]
ease = "quadratic_out"

[[tracks.channel.keys]]
at = 0.07
to = [
    0.008078201,
    -0.09454624,
    0.094477676,
]
ease = "cubic_in_out"

[[tracks.channel.keys]]
at = 0.5
to = [
    -0.0,
    0.0,
    0.0,
]
ease = "linear"

