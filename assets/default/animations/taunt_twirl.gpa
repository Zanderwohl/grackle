length = 4.0
clock = "seconds"
looping = false
note = "Written by `pistol_twirl::clip`: the support hand goes to the hip as the pistol comes down by the right of the chest; a flick lifts the barrel and the grip lets go, and it spins three times on the trigger finger, barrel down and back, slowing; the palm closes on it with a rock; it comes up through an arc, turning upright, its barrel before the lips; a breath in, a breath out across it with the head leaning in, a pleased tilt, and back to the hold. The pistol is keyed and the trigger hand only where the spin frees it, so retune it there."

[[tracks]]
combine = "replace"
space = "body"
unit = "meters"
enabled = true

