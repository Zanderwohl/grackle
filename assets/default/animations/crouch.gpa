name_key = "animation.states.crouch"
length = 1.0
clock = "shared"
looping = false
note = "Sampled from `crouch_posture`. Still, so one key says all of it — the length is a formality."

[[tracks]]
combine = "replace"
space = "body"
unit = "metres"
enabled = true

