name_key = "animation.states.crouch_airborne"
length = 1.6
clock = "shared"
looping = true
note = "Sampled from `crouch_posture` with `airborne_legs`: folded like a crouch, pedaling tucked. `duck_under` folds it under the short hull afterward and `tuck_into_the_box` lifts the feet above its bottom."

