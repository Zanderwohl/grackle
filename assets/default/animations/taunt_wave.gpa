length = 2.0
clock = "seconds"
looping = false
note = "Sampled from `humanoid_seed::wave` on the reference build: the right hand swings up the side to beside the head, overshooting a little, with the body leaning away from it; three sweeps out and in, the hand trailing the forearm, the hips sliding under a chest that sways after the hand and the head tilting after that; then the arm comes down and the body settles. The feet are solved onto the floor and the wrist onto points from between the shoulders, so retune it there."

[[tracks]]
combine = "replace"
space = "body"
unit = "meters"
enabled = true

[tracks.channel]
channel = "rotation"
bone = "pelvis"

