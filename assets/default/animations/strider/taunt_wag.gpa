name_key = ""
length = 1.2
clock = "seconds"
looping = false
note = "The strider's wave: the tail lifted and wagged four times while the head looks up. As long as the wave, since a taunt's length is read off its humanoid clip."

[[tracks]]
combine = "replace"
space = "body"
unit = "meters"
enabled = true

[tracks.channel]
channel = "effector"
chain = "tail"

[[tracks.channel.keys]]
at = 0.0
to = [0.0, 0.95, 0.6]
ease = "smoother_step"

[[tracks.channel.keys]]
at = 0.3
to = [0.3, 1.1, 0.45]
ease = "smoother_step"

[[tracks.channel.keys]]
at = 0.6
to = [-0.3, 1.1, 0.45]
ease = "smoother_step"

[[tracks.channel.keys]]
at = 0.9
to = [0.3, 1.1, 0.45]
ease = "smoother_step"

[[tracks.channel.keys]]
at = 1.2
to = [0.0, 0.95, 0.6]
ease = "smoother_step"

[[tracks]]
combine = "replace"
space = "body"
unit = "meters"
enabled = true

[tracks.channel]
channel = "look_at"
bone = "head"

[[tracks.channel.keys]]
at = 0.0
to = [0.0, 2.2, -1.5]
ease = "smoother_step"
