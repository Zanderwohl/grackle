name_key = "animation.states.strafe_right"
length = 1.0
clock = "stride"
looping = true
note = "Sampled from `gait_pose` at a walk, one stride per clip. Only the upper body and the hips: the legs are the gait's own, planted from the stride. Each arm is timed by the foot on its side, so it is right at any speed."

[[tracks]]
combine = "replace"
space = "body"
unit = "metres"
enabled = true

[tracks.channel]
channel = "rotation"
bone = "chest"

[[tracks.channel.keys]]
at = 0.0
to = [
    -0.0,
    0.0,
    0.12,
]
ease = "linear"

