name_key = "animation.states.strafe_right"
length = 1.0
clock = "stride"
looping = true
note = "Sampled from `gait_pose` at a run, one stride per clip. Only the upper body and the hips: the legs are the gait's own, planted from the stride. Each arm is timed by the foot on its side, so it lands with its foot at any speed."

