[animations.clips.reload]
name_key = "anim.clips.reload"
length = 1.0
clock = "seconds"
looping = false
note = "The RPG's reload: swung left and back while the free hand takes the next round from the left hip at 20 %, carries it to the front of the tube and seats it at 72 %. The round's keys are the hand's, moved by one fixed offset, so it stays in the hand. Fitted to the reload time."
