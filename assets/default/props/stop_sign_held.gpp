[animations.clips.fire]
name_key = "anim.clips.fire"
length = 0.5
clock = "seconds"
looping = false
note = "The stop sign's swing in first person: tipped back for 0.05 s, then chopped down so the face of the sign is on the crosshair from 0.12 s to 0.3 s, whatever the window's shape, and brought back by 0.5 s. The hold is a place and a turn in eye space; the ends are the framing, so they move with it."
